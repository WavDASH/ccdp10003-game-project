markers = [{
"body": "One player cannot hold two switches at once. The door stays closed unless both switches are pressed together.",
"game_time": 0.0,
"id": "start",
"label": "Start",
"note": "The problem is not movement speed — it is being in two places at the same time.",
"t": 0.0,
"title": "The Impossible Room"
}, {
"body": "The player first performs a useful action: reaching the first switch. This action becomes the history that the room will remember.",
"game_time": 1.0833333333333344,
"id": "record_action",
"label": "Record Action",
"note": "Forward time defines what happened.",
"t": 1.0666666666666678,
"title": "Recording an Action"
}, {
"body": "Time moves backward, but the action is not deleted. Instead, it becomes a replayable trace.",
"game_time": 2.6999999999999953,
"id": "rewind_start",
"label": "Rewind",
"note": "Rewind is not reset.",
"t": 2.716666666666662,
"title": "Rewinding Time"
}, {
"body": "The past action returns as an Echo. It follows the recorded path and can take part in the puzzle.",
"game_time": 2.6833333333333287,
"id": "echo_appears",
"label": "Echo Appears",
"note": "The past self becomes a partner.",
"t": 2.7333333333333285,
"title": "The Echo"
}, {
"body": "The Echo repeats the first action while the present player takes a new path toward the second switch.",
"game_time": 1.35,
"id": "cooperate",
"label": "Cooperate",
"note": "One player creates cooperation across time.",
"t": 5.833333333333318,
"title": "Cooperating With the Past"
}, {
"body": "Both switches are now active: one held by the Echo, one reached by the present player. The door opens.",
"game_time": 1.35,
"id": "door_opens",
"label": "Door Opens",
"note": "The solution is built from overlapping timelines.",
"t": 5.833333333333318,
"title": "History Becomes the Solution"
}, {
"body": "The player has used a past action and a present action together to pass through the room.",
"game_time": 3.866666666666658,
"id": "end",
"label": "End",
"note": "The room is not just space — it is layered time.",
"t": 8.366666666666662,
"title": "The Timeline Solves the Room"
}]
